# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=<project-id>

# ── Google Maps (optional – used for event location autocomplete) ─────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── LINE LIFF ─────────────────────────────────────────────────────────────────
# สร้าง LIFF app ที่ developers.line.biz → Providers → Channel → LIFF
# LIFF URL จะเป็น: https://liff.line.me/<liff-id>
# Endpoint URL ใน LIFF Console: https://<your-domain>
VITE_LINE_LIFF_ID=

# ── LINE OA / Messaging API (ใส่ใน Supabase Edge Function secrets) ───────────
# LINE_CHANNEL_ACCESS_TOKEN=          # long-lived token จาก LINE Messaging API
# LINE_CHANNEL_SECRET=                # channel secret สำหรับ verify webhook signature
# LINE_LOGIN_CHANNEL_SECRET=          # channel secret ของ LINE Login channel

# ── Make.com Webhooks ────────────────────────────────────────────────────────
# MAKE_WEBHOOK_SECRET=                # secret key สำหรับ authenticate requests จาก Make.com
#                                     # ใส่ใน Supabase Edge Function secrets

# Make.com webhook URL สำหรับ Registration scenario (เปิดเผยได้บน frontend — Make.com handle auth เอง)
VITE_MAKE_REGISTER_WEBHOOK_URL=

# ── Registration API Key ──────────────────────────────────────────────────────
# REGISTER_API_KEY=                   # Internal secret ป้องกัน /functions/v1/auth-register
#                                     # Make.com ส่ง X-Api-Key header ด้วย key นี้
#                                     # ใส่ใน: Supabase Edge Function secrets AND Make.com HTTP module header

# ── Stripe (ใส่ใน Supabase Edge Function secrets) ────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
